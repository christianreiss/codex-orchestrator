  "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "ignoreDependencies": ["pino-pretty", "libsodium", "@types/libsodium-wrappers"],
  "ignoreExportsUsedInFile": true
}
