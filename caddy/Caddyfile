{
	servers :443 {
		protocols h1 h2
	}

	servers :80 {
		protocols h1 h2c
	}
}

{$CADDY_DOMAIN} {
	import {$CADDY_TLS_FRAGMENT}

	encode zstd gzip
	log

	# One rule for every path. `/admin*` used to be split out into its own
	# fragment so a client certificate could be demanded for it; this server no
	# longer issues or verifies certificates, and the console is protected by its
	# admin session instead. If something in front of this terminates mTLS and
	# forwards `X-MTLS-*`, the API reads those headers — but only from a peer
	# inside TRUSTED_PROXY_CIDRS, and it still gates nothing on them.
	handle {
		reverse_proxy api:8080 {
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote}
		}
	}
}
