APP_ENV=production

# `cookie` (default) or `open`. Controls one thing: whether /cli/auth/verify
# requires an admin session. Nothing here is about certificates.
ADMIN_ACCESS_MODE=cookie
ADMIN_WS_ENABLED=0
# ADMIN_WS_PUBLIC_URL=wss://codex-auth.example.com/admin/ws
ADMIN_WS_BIND=0.0.0.0:8091
ADMIN_WS_POLL_INTERVAL=1
ADMIN_WS_PING_INTERVAL=25
ADMIN_WS_BACKLOG_LIMIT=200

# Optional Android companion push. Mount these files on the API service;
# paths are inside the container. See docs/android-companion.md.
# COMPANION_FIREBASE_CONFIG_FILE=/run/secrets/companion-google-services.json
# COMPANION_FIREBASE_CREDENTIAL_FILE=/run/secrets/companion-firebase.json
# Instead of CONFIG_FILE, the public Android identifiers may be supplied directly:
# COMPANION_FIREBASE_PROJECT_ID=your-project-id
# COMPANION_FIREBASE_APP_ID=1:123456789:android:your-app-id
# COMPANION_FIREBASE_API_KEY=your-public-firebase-app-api-key
# COMPANION_FIREBASE_SENDER_ID=123456789

AUTH_RUNNER_BYPASS_SUBNETS=172.28.0.0/16,172.30.0.0/16
AUTH_RUNNER_IP_BYPASS=0
AUTH_RUNNER_SHARED_SECRET=
AUTH_RUNNER_TIMEOUT=8
# Authentication probes stay short. OpenAI/Anthropic compatibility calls get
# their own full CLI-turn budget (the runner enforces its 600-second maximum).
AUTH_RUNNER_EXEC_TIMEOUT=600
# Background auth verification cadence (seconds). TTL is the minimum probe
# interval; the worker backs off dynamically to the max as the credential
# proves itself, and successful gateway traffic counts as proof.
AUTH_RUNNER_VERIFY_TTL_SECONDS=900
AUTH_RUNNER_VERIFY_MAX_INTERVAL_SECONDS=21600
AUTH_RUNNER_URL=http://auth-runner:8080/verify
AUTH_SEED_TOKEN_TTL_SECONDS=900

# ChatGPT quota refresh (quota-cron sidecar)
CHATGPT_USAGE_CRON_INTERVAL=900

# Set both when a reverse proxy sits in front, listing the proxy's own address.
# They gate every header the edge injects on this server's behalf: X-Forwarded-*,
# and the X-MTLS-Fingerprint/Subject/Issuer claims a proxy that terminates mTLS
# may forward. A caller outside these ranges can send those headers too, so
# claims from one are discarded. Left at 0, no forwarded header is believed.
# `bin/install.sh` fills these in for you.
TRUST_X_FORWARDED=0
TRUSTED_PROXY_CIDRS=

# Optional Caddy frontend (disabled unless the `caddy` compose profile is used).
# It terminates TLS and reverse-proxies; it does not request client certificates.
CADDY_ACME_EMAIL=ops@example.com
CADDY_DOMAIN=codex-auth.example.com
CADDY_TLS_CERT_FILE=/etc/caddy/tls/tls.crt
CADDY_TLS_DIR=/var/docker_data/codex-auth.example.com/caddy/tls
CADDY_TLS_FRAGMENT=/etc/caddy/tls-acme.caddy
CADDY_TLS_KEY_FILE=/etc/caddy/tls/tls.key

CODEX_DEBUG=0
CODEX_SYNC_BASE_URL=https://codex-auth.example.com
CODEX_AUTH_SUBNET=172.30.250.0/24
CODEX_AUTH_GATEWAY=172.30.250.1
RUNNER_CODEX_PROBE_MODEL=gpt-6-astra
PUBLIC_BASE_URL=https://codex-auth.example.com
PUBLIC_BASE_URL_REQUIRED=1
# Optional separate publicly trusted HTTPS origin for cloud OAuth connectors.
# Keep it under the existing WebAuthn RP domain to reuse existing passkeys.
# CONNECTOR_PUBLIC_BASE_URL=https://connectors.codex-auth.example.com
# Comma-separated cross-site origins allowed credentialed CORS access to
# admin/host routes (/v1 and /anthropic/v1 stay open regardless). Empty by
# default: those routes are same-origin only.
# CORS_ALLOWED_ORIGINS=https://admin.example.com
MCP_ALLOW_REQUEST_HOST_ORIGIN=0
# The API applies every pending file in api/src/db/migrations before it opens a
# listener. Setting this to 0 does not disable the check: boot still fails when a
# migration is pending. Apply out of band with `node dist/migrate.js`.
RUN_MIGRATIONS_ON_BOOT=1
# Seconds to wait for the migration advisory lock (several API instances booting).
MIGRATIONS_LOCK_TIMEOUT=120
# Grace period after insecure window closes (minutes). Set to 0 to disable.
INSECURE_GRACE_MINUTES=60

# OpenTelemetry spans on the wrapper config bakery. Off unless this is truthy,
# and off means the SDK is never even imported. Destination, headers and
# sampling come from the standard OTEL_EXPORTER_OTLP_* / OTEL_TRACES_SAMPLER*
# variables, which the SDK reads itself. See docs/wrapper-v2-architecture.md.
OTEL_TRACES_ENABLED=0
# OTEL_SERVICE_NAME=codex-orchestrator-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

DATA_ROOT=/var/docker_data/codex-auth.example.com

DB_BACKUP_CRON="0 2 * * *"
DB_BACKUP_MAX=30
DB_CHARSET=utf8mb4
DB_DATABASE=codex_auth
DB_HOST=mysql
DB_PASSWORD=codex-pass
DB_PORT=3306
DB_ROOT_PASSWORD=root-pass
DB_USERNAME=codex

ENV_FILE=./.env

# Will be auto-generated on first boot when empty.
# AUTH_ENCRYPTION_KEY=
# Optional rotation format: AUTH_ENCRYPTION_KEYS=kid1:base64key,kid2:base64key
# AUTH_ENCRYPTION_ACTIVE_KID=kid1
# NOTE: Keep real secrets out of `.env.example`. For prod, prefer a separate `.env.local`
# and point `ENV_FILE=./.env.local` so app defaults don't stomp your live DATA_ROOT/keys.

# Runner-side controls
RUNNER_SHARED_SECRET=
RUNNER_DEBUG_DUMP_AUTH=0
RUNNER_ALLOW_SECRET_DUMP=0

INSTALLATION_ID=

# ── Claude / Anthropic engine support ─────────────────────────
# Optional: Anthropic API key for runner Claude validation.
# ANTHROPIC_API_KEY=

# Default engines for new hosts (comma-separated subset of codex, claude, grok, kimi)
DEFAULT_HOST_ENGINES=codex

# Permanent per-user agent portal. The persistent master switch is seeded off
# in MySQL on first deployment and is changed from Admin -> Settings.
# Nothing is pushed anywhere: each user holds one permanent link, read back from
# Admin -> Settings -> Agent Portal, that they bookmark. PUBLIC_BASE_URL above is
# the only configuration the portal needs.
AGENT_PORTAL_RETENTION_HOURS=24
AGENT_PORTAL_BRIDGE_TTL_SECONDS=900

# Shared cxx control transport; enable after deploying cxx 0.9.71.
CXX_COMMUNICATOR_ENABLED=false
CXX_COMMUNICATOR_SYNC_ENABLED=false
# Unified resident runtime rollout; independent of transport and sync.
CXX_COMMUNICATOR_RUNTIME_ENABLED=false
# Push-triggered, quiet-gated updater (needs transport). Warm-cache launches
# have no switch: they come with transport + sync.
CXX_COMMUNICATOR_UPDATE_ENABLED=false
# Staged cxx rollout: a newly deployed cxx goes to canary hosts, then waves.
# Off serves every host the newest release at once and ignores a stored rollout.
CXX_WRAPPER_ROLLOUT_ENABLED=false
CXX_WRAPPER_ROLLOUT_STAGES=canary,10,50,100
CXX_WRAPPER_ROLLOUT_SOAK_MINUTES=30
