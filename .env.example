APP_ENV=production

ADMIN_ACCESS_MODE=mtls
ADMIN_WS_ENABLED=0
# ADMIN_WS_PUBLIC_URL=wss://codex-auth.example.com/admin/ws
ADMIN_WS_BIND=0.0.0.0:8091
ADMIN_WS_POLL_INTERVAL=1
ADMIN_WS_PING_INTERVAL=25
ADMIN_WS_BACKLOG_LIMIT=200

AUTH_RUNNER_BYPASS_SUBNETS=172.28.0.0/16,172.30.0.0/16
AUTH_RUNNER_CODEX_BASE_URL=https://codex-auth.example.com
AUTH_RUNNER_IP_BYPASS=0
AUTH_RUNNER_SHARED_SECRET=
AUTH_RUNNER_TIMEOUT=8
# Background auth verification freshness and worker interval (seconds).
AUTH_RUNNER_VERIFY_TTL_SECONDS=900
AUTH_RUNNER_VERIFY_WORKER_INTERVAL_SECONDS=300
AUTH_RUNNER_URL=http://auth-runner:8080/verify
AUTH_SEED_TOKEN_TTL_SECONDS=900

# ChatGPT quota refresh (quota-cron sidecar)
CHATGPT_USAGE_CRON_INTERVAL=3600
CHATGPT_USAGE_HEALTH_PATH=/tmp/chatgpt-usage-health.json
# Leave empty to use CHATGPT_USAGE_CRON_INTERVAL + 300 seconds.
CHATGPT_USAGE_HEALTH_MAX_AGE_SECONDS=

# Only trust X-Forwarded-* headers when the direct caller is in TRUSTED_PROXY_CIDRS.
TRUST_X_FORWARDED=0
TRUSTED_PROXY_CIDRS=

# Optional Caddy frontend (disabled unless the `caddy` compose profile is used)
CADDY_ACME_EMAIL=ops@example.com
CADDY_DOMAIN=codex-auth.example.com
CADDY_MTLS_CA_FILE=/etc/caddy/mtls/ca.crt
CADDY_MTLS_DIR=/var/docker_data/codex-auth.example.com/caddy/mtls
CADDY_TLS_CERT_FILE=/etc/caddy/tls/tls.crt
CADDY_TLS_DIR=/var/docker_data/codex-auth.example.com/caddy/tls
CADDY_TLS_FRAGMENT=/etc/caddy/tls-acme.caddy
CADDY_TLS_KEY_FILE=/etc/caddy/tls/tls.key

CODEX_DEBUG=0
CODEX_SYNC_BASE_URL=https://codex-auth.example.com
CODEX_AUTH_SUBNET=172.30.250.0/24
CODEX_AUTH_GATEWAY=172.30.250.1
RUNNER_CODEX_PROBE_MODEL=gpt-5.6-terra
PUBLIC_BASE_URL=https://codex-auth.example.com
PUBLIC_BASE_URL_REQUIRED=1
# Comma-separated cross-site origins allowed credentialed CORS access to
# admin/host routes (/v1 and /anthropic/v1 stay open regardless). Empty by
# default: those routes are same-origin only.
# CORS_ALLOWED_ORIGINS=https://admin.example.com
STRICT_HOST_VALIDATION=1
MCP_ALLOW_REQUEST_HOST_ORIGIN=0
RUN_MIGRATIONS_ON_BOOT=0
RUN_BACKFILLS_ON_BOOT=0
# Grace period after insecure window closes (minutes). Set to 0 to disable.
INSECURE_GRACE_MINUTES=60

DATA_ROOT=/var/docker_data/codex-auth.example.com

DB_BACKUP_CRON="0 2 * * *"
DB_BACKUP_MAX=30
DB_CHARSET=utf8mb4
DB_DATABASE=codex_auth
DB_HOST=mysql
DB_PASSWORD=codex-pass
DB_PORT=3306
DB_ROOT_PASSWORD=root-pass
DB_USERNAME=codex

ENV_FILE=./.env

# Will be auto-generated on first boot when empty.
# AUTH_ENCRYPTION_KEY=
# Optional rotation format: AUTH_ENCRYPTION_KEYS=kid1:base64key,kid2:base64key
# AUTH_ENCRYPTION_ACTIVE_KID=kid1
# NOTE: Keep real secrets out of `.env.example`. For prod, prefer a separate `.env.local`
# and point `ENV_FILE=./.env.local` so app defaults don't stomp your live DATA_ROOT/keys.

# Runner-side controls
RUNNER_SHARED_SECRET=
RUNNER_DEBUG_DUMP_AUTH=0
RUNNER_ALLOW_SECRET_DUMP=0

# Pricing for GPT-5.1 (per 1k tokens)
# PRICING_URL=https://your-pricing-endpoint/pricing.json
GPT51_CACHED_PER_1K=0.000125
GPT51_INPUT_PER_1K=0.00125
GPT51_OUTPUT_PER_1K=0.01
PRICING_CURRENCY=USD
CHATGPT_PLUS_PLAN_COST=20
CHATGPT_PRO_PLAN_COST=200
INSTALLATION_ID=

# ── Claude / Anthropic engine support ─────────────────────────
# Pricing for Claude models (per 1k tokens)
CLAUDE_OPUS_CACHED_PER_1K=0.0075
CLAUDE_OPUS_INPUT_PER_1K=0.015
CLAUDE_OPUS_OUTPUT_PER_1K=0.075
CLAUDE_SONNET_CACHED_PER_1K=0.0015
CLAUDE_SONNET_INPUT_PER_1K=0.003
CLAUDE_SONNET_OUTPUT_PER_1K=0.015
CLAUDE_HAIKU_CACHED_PER_1K=0.0004
CLAUDE_HAIKU_INPUT_PER_1K=0.0008
CLAUDE_HAIKU_OUTPUT_PER_1K=0.004

# Optional: Anthropic API key for runner Claude validation.
# ANTHROPIC_API_KEY=

# Default engines for new hosts (comma-separated: codex, claude, or codex,claude)
DEFAULT_HOST_ENGINES=codex
