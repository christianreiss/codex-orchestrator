{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /sync/status response",
  "type": "object",
  "required": [
    "status",
    "data"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "update"
      ]
    },
    "data": {
      "type": "object",
      "required": [
        "status",
        "reasons",
        "engine",
        "versions",
        "api_calls",
        "host_users",
        "bootstrap"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "update"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engine": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "versions": {
          "type": "object",
          "description": "Version snapshot for the requested engine; same shape as `data` in versions.schema.json."
        },
        "api_calls": {
          "type": "integer"
        },
        "host_users": {
          "type": "array"
        },
        "bootstrap": {
          "const": false,
          "description": "Always false on the check-in route. Agents/config rendering is served by /sync/bootstrap only."
        },
        "auth": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "auth": {
              "type": "object"
            },
            "quota_advice": { "$ref": "#/$defs/quotaAdvice" },
            "claude_usage": {
              "description": "Stored Claude Code statusline telemetry; fetched_at is the original report receipt time, not the response time.",
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": { "enum": ["ok", "unavailable"] },
                "id": { "type": "integer" },
                "host_id": { "type": ["integer", "null"] },
                "source": { "type": ["string", "null"] },
                "fetched_at": { "type": "string", "format": "date-time" },
                "five_hour_used_percent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
                "five_hour_resets_at": { "type": ["string", "null"] },
                "seven_day_used_percent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
                "seven_day_resets_at": { "type": ["string", "null"] },
                "five_hour_window": {
                  "type": "object",
                  "required": ["used_percent", "resets_at"],
                  "properties": {
                    "used_percent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
                    "resets_at": { "type": ["string", "null"] }
                  },
                  "additionalProperties": true
                },
                "seven_day_window": {
                  "type": "object",
                  "required": ["used_percent", "resets_at"],
                  "properties": {
                    "used_percent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
                    "resets_at": { "type": ["string", "null"] }
                  },
                  "additionalProperties": true
                }
              },
              "allOf": [{
                "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
                "then": {
                  "properties": { "fetched_at": {}, "five_hour_window": {}, "seven_day_window": {} },
                  "required": ["fetched_at", "five_hour_window", "seven_day_window"]
                }
              }],
              "additionalProperties": true
            },
            "verification_state": {
              "type": "string",
              "enum": [
                "verified",
                "failed",
                "unknown"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "auth"
                ],
                "properties": {
                  "auth": {
                    "type": "object"
                  }
                }
              },
              "then": {
                "required": [
                  "verification_state"
                ],
                "properties": {
                  "verification_state": {
                    "const": "verified"
                  }
                }
              }
            }
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "quotaAdvice": {
      "type": "object",
      "required": [
        "settings",
        "codex",
        "claude"
      ],
      "properties": {
        "settings": {
          "type": "object",
          "required": [
            "mode",
            "high_usage_percent",
            "projected_usage_percent",
            "min_pressure_gap",
            "max_age_minutes",
            "remember_day"
          ],
          "properties": {
            "mode": {
              "enum": [
                "off",
                "hint",
                "ask"
              ]
            },
            "remember_day": {
              "type": "boolean"
            },
            "high_usage_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "projected_usage_percent": {
              "type": "integer",
              "minimum": 100,
              "maximum": 500
            },
            "min_pressure_gap": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_age_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            }
          },
          "additionalProperties": true
        },
        "codex": {
          "$ref": "#/$defs/quotaAdviceSnapshot"
        },
        "claude": {
          "$ref": "#/$defs/quotaAdviceSnapshot"
        }
      },
      "additionalProperties": true
    },
    "quotaAdviceSnapshot": {
      "type": "object",
      "required": [
        "available",
        "status",
        "fetched_at",
        "limit_reached",
        "windows"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "fetched_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "limit_reached": {
          "type": "boolean"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quotaAdviceWindow"
          }
        }
      },
      "additionalProperties": true
    },
    "quotaAdviceWindow": {
      "type": "object",
      "required": [
        "used_percent",
        "limit_seconds",
        "reset_at"
      ],
      "properties": {
        "used_percent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "limit_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reset_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  }
}
