{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /sync/status response",
  "type": "object",
  "required": [
    "status",
    "data"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "update"
      ]
    },
    "data": {
      "type": "object",
      "required": [
        "status",
        "reasons",
        "engine",
        "versions",
        "api_calls",
        "host_users",
        "bootstrap"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "update"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engine": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "versions": {
          "type": "object",
          "description": "Version snapshot for the requested engine; same shape as `data` in versions.schema.json."
        },
        "api_calls": {
          "type": "integer"
        },
        "host_users": {
          "type": "array"
        },
        "bootstrap": {
          "const": false,
          "description": "Always false on the check-in route. Agents/config rendering is served by /sync/bootstrap only."
        },
        "auth": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "auth": {
              "type": "object"
            },
            "verification_state": {
              "type": "string",
              "enum": [
                "verified",
                "failed",
                "unknown"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "auth"
                ],
                "properties": {
                  "auth": {
                    "type": "object"
                  }
                }
              },
              "then": {
                "required": [
                  "verification_state"
                ],
                "properties": {
                  "verification_state": {
                    "const": "verified"
                  }
                }
              }
            }
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
