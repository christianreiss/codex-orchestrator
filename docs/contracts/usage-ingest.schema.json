{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /usage response",
  "type": "object",
  "required": [
    "status",
    "data"
  ],
  "properties": {
    "status": {
      "const": "ok"
    },
    "data": {
      "type": "object",
      "required": [
        "recorded"
      ],
      "properties": {
        "recorded": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "host_id": {
          "type": "integer"
        },
        "ingest_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "usages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "recorded_at",
              "line",
              "total",
              "input",
              "output",
              "cached",
              "reasoning",
              "model"
            ],
            "properties": {
              "recorded_at": {
                "type": "string"
              },
              "line": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "total": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "input": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "output": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cached": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "reasoning": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "recorded",
            "host_id",
            "ingest_id",
            "usages"
          ],
          "properties": {
            "recorded": {
              "type": "integer"
            }
          }
        },
        {
          "required": [
            "recorded",
            "reason"
          ],
          "properties": {
            "recorded": {
              "const": false
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
