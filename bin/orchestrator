#!/usr/bin/env bash
set -euo pipefail

INSTANCE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=bin/lib/instance-compose.sh
source "$INSTANCE_ROOT/bin/lib/instance-compose.sh"
declare -a INSTANCE_PROFILES=()
instance_env_path

usage() {
  cat <<'EOF'
Usage: bin/orchestrator COMMAND [options]

Manage this local Docker Compose instance from any directory.
  setup [installer options]  Run/resume setup (see setup --help).
  start                      Start configured services and verify readiness.
  stop                       Stop all services, preserving containers and data.
  status [--json]             Read-only service, health and readiness report.
  update [--repo-url URL]     Back up, fetch GitHub main, rebuild and restart.

Options for start/stop/status/update:
  --profile NAME             Enable an additional Compose profile (repeatable).
  --env-file PATH            Select an env file, relative to this checkout.
  -h, --help                 Show help without requiring Docker.

ENV_FILE also selects an env file (default: .env). Setup accepts the installer's
flags unchanged. COMPOSE_PROFILES records enabled profiles; an existing Caddy
container is also detected. Update requires a clean main checkout and accepts
only fast-forwards. It starts stopped instances and retains backups under
DATA_ROOT/backups. Exit codes: 0 success/ready, 1 failure/not ready, 2 usage.
EOF
}

log() { printf '[instance] %s\n' "$*" >&2; }
fail() { log "ERROR: $*"; exit 1; }
usage_error() { ORCHESTRATOR_USAGE_FAILED=1; log "ERROR: $*"; exit 2; }
require_cmd() { command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"; }

readiness() {
  # Query inside the API container: respects remote Docker contexts, needs no
  # host port, and reads a 503 body as well as a 200 body.
  instance_compose exec -T api node -e '
    fetch("http://127.0.0.1:8080/readyz", {signal: AbortSignal.timeout(10000)})
      .then(async r => process.stdout.write(await r.text()))
      .catch(() => process.exit(1));
  ' 2>/dev/null
}

cmd_status() {
  local services containers ready revision
  services="$(instance_compose config --services)" || fail "could not resolve Compose services"
  containers="$(instance_compose --profile '*' ps --all --format json)" || fail "could not query Docker containers"
  ready="$(readiness || true)"
  revision="$(git -C "$INSTANCE_ROOT" rev-parse --short HEAD 2>/dev/null || printf unknown)"
  printf '%s\0%s\0%s' "$services" "$containers" "$ready" |
    python3 "$INSTANCE_ROOT/bin/lib/instance-status.py" "$OUTPUT_MODE" "$revision" "$ENV_PATH"
}

lock_instance() {
  require_cmd flock
  local lock_file="$INSTANCE_ROOT/.orchestrator.lock"
  if [[ "${ORCHESTRATOR_UPDATE_PHASE:-}" == deploy ]]; then
    [[ "$(readlink /proc/self/fd/9 2>/dev/null)" == "$lock_file" ]] || fail "update continuation lost its lock"
  else
    exec 9>"$lock_file"
  fi
  flock -n 9 || fail "another instance command holds $lock_file"
}

backup_instance() {
  local data_root
  data_root="$(instance_env_get DATA_ROOT || true)"
  [[ -n "$data_root" ]] || fail "DATA_ROOT is unset; run bin/orchestrator setup"
  [[ "$data_root" == /* ]] || data_root="$INSTANCE_ROOT/$data_root"
  mkdir -p "$data_root/backups"
  BACKUP_DIR="$(mktemp -d "$data_root/backups/update-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")"
  chmod 700 "$BACKUP_DIR"
  cp "$ENV_PATH" "$BACKUP_DIR/env"
  chmod 600 "$BACKUP_DIR/env"
  printf '%s\n' "$PREVIOUS_REV" > "$BACKUP_DIR/previous-revision"
  printf '%s\n' "$TARGET_REV" > "$BACKUP_DIR/target-revision"
  log "Writing backup to $BACKUP_DIR"
  # Credentials expand inside the container, never in command output.
  # shellcheck disable=SC2016
  instance_compose exec -T mysql sh -lc \
    'mysqldump --single-transaction --no-tablespaces -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE"' \
    > "$BACKUP_DIR/database.sql.partial"
  if [[ ! -s "$BACKUP_DIR/database.sql.partial" ]] ||
    ! tail -n 5 "$BACKUP_DIR/database.sql.partial" | grep -q '^-- Dump completed on '; then
    fail "database dump is incomplete; checkout was not advanced"
  fi
  mv "$BACKUP_DIR/database.sql.partial" "$BACKUP_DIR/database.sql"
}

cmd_update() {
  require_cmd git
  require_cmd curl
  local source fetch_ref
  if [[ "${ORCHESTRATOR_UPDATE_PHASE:-}" == deploy ]]; then
    PREVIOUS_REV="$ORCHESTRATOR_PREVIOUS_REV"
    TARGET_REV="$ORCHESTRATOR_TARGET_REV"
    BACKUP_DIR="$ORCHESTRATOR_BACKUP_DIR"
    [[ "$(git -C "$INSTANCE_ROOT" rev-parse HEAD)" == "$TARGET_REV" ]] || fail "checkout changed during update"
    [[ -s "$BACKUP_DIR/database.sql" ]] || fail "update backup is missing"
    STAGE=deploy
    # Preserve detected/explicit profiles across re-exec and the deploy helper.
    local -a deploy_args=(--skip-git --no-cleanup)
    local profile
    for profile in "${INSTANCE_PROFILES[@]}"; do deploy_args+=(--profile "$profile"); done
    ENV_FILE="$ENV_PATH" bash "$INSTANCE_ROOT/scripts/deploy.sh" "${deploy_args[@]}"
    STAGE=readiness
    cmd_status
    log "Update complete: $PREVIOUS_REV -> $TARGET_REV; backup: $BACKUP_DIR"
    return
  fi
  STAGE=preflight
  [[ "$(git -C "$INSTANCE_ROOT" branch --show-current)" == main ]] || fail "update requires branch main"
  PREVIOUS_REV="$(git -C "$INSTANCE_ROOT" rev-parse HEAD)"
  [[ -z "$(git -C "$INSTANCE_ROOT" status --porcelain --untracked-files=all)" ]] ||
    fail "checkout has local changes or untracked files; update will not overwrite them"
  source="$REPO_URL"
  if [[ -z "$source" ]]; then
    source="$(git -C "$INSTANCE_ROOT" remote get-url github 2>/dev/null || printf '%s' https://github.com/christianreiss/codex-orchestrator.git)"
  fi
  STAGE=fetch
  log "Fetching main from the update repository"
  # FETCH_HEAD is shared with other Git users. Read a command-private ref so
  # an unrelated fetch cannot change the revision this update will deploy.
  fetch_ref="refs/orchestrator/update-$$"
  git -C "$INSTANCE_ROOT" fetch --no-tags -- "$source" "refs/heads/main:$fetch_ref"
  TARGET_REV="$(git -C "$INSTANCE_ROOT" rev-parse "$fetch_ref")"
  git -C "$INSTANCE_ROOT" update-ref -d "$fetch_ref"
  git -C "$INSTANCE_ROOT" merge-base --is-ancestor "$PREVIOUS_REV" "$TARGET_REV" ||
    fail "local main is ahead of or diverges from GitHub main; fast-forward refused"
  log "Update: $PREVIOUS_REV -> $TARGET_REV"
  [[ -f "$INSTANCE_ROOT/bin/orchestrator" ]] || fail "instance CLI missing from checkout"
  git -C "$INSTANCE_ROOT" cat-file -e "$TARGET_REV:bin/orchestrator" ||
    fail "target revision does not contain the instance CLI"
  STAGE=database
  instance_compose up -d --no-build --wait --wait-timeout 180 mysql
  STAGE=backup
  backup_instance
  STAGE=fast-forward
  [[ "$(git -C "$INSTANCE_ROOT" rev-parse HEAD)" == "$PREVIOUS_REV" &&
     -z "$(git -C "$INSTANCE_ROOT" status --porcelain --untracked-files=all)" ]] ||
    fail "checkout changed during backup; fast-forward refused"
  # This function has already been parsed in full, so replacing the running
  # script cannot make Bash consume a mixture of the old and new files.
  git -C "$INSTANCE_ROOT" merge --ff-only "$TARGET_REV"
  export ORCHESTRATOR_UPDATE_PHASE=deploy ORCHESTRATOR_PREVIOUS_REV="$PREVIOUS_REV"
  export ORCHESTRATOR_TARGET_REV="$TARGET_REV" ORCHESTRATOR_BACKUP_DIR="$BACKUP_DIR"
  local -a continuation=(update --env-file "$ENV_PATH")
  local profile
  for profile in "${INSTANCE_PROFILES[@]}"; do continuation+=(--profile "$profile"); done
  exec bash "$INSTANCE_ROOT/bin/orchestrator" "${continuation[@]}"
}

main() {
  local command="${1:---help}"
  shift || true
  case "$command" in -h|--help|help) usage; return ;; esac
  case "$command" in setup|start|stop|status|update) ;; *) usage_error "unknown command: $command" ;; esac
  OUTPUT_MODE=human REPO_URL="" STAGE="$command"
  PREVIOUS_REV="${ORCHESTRATOR_PREVIOUS_REV:-unknown}"
  TARGET_REV="${ORCHESTRATOR_TARGET_REV:-unknown}"
  BACKUP_DIR="${ORCHESTRATOR_BACKUP_DIR:-none}"
  if [[ "$command" == setup ]]; then
    for arg in "$@"; do
      case "$arg" in -h|--help) exec bash "$INSTANCE_ROOT/bin/install.sh" "$@" ;; esac
    done
    lock_instance
    exec bash "$INSTANCE_ROOT/bin/install.sh" "$@"
  fi
  while (( $# )); do
    case "$1" in
      -h|--help) usage; return ;;
      --json) [[ "$command" == status ]] || usage_error "--json is for status"; OUTPUT_MODE=json ;;
      --repo-url) [[ "$command" == update && $# -ge 2 && -n "$2" ]] || usage_error "--repo-url needs a URL and update"; REPO_URL="$2"; shift ;;
      --env-file) [[ $# -ge 2 && -n "$2" ]] || usage_error "--env-file needs a path"; ENV_FILE="$2"; instance_env_path; shift ;;
      --profile) [[ $# -ge 2 && -n "$2" ]] || usage_error "--profile needs a name"; INSTANCE_PROFILES+=("$2"); shift ;;
      *) usage_error "unknown option: $1" ;;
    esac
    shift
  done
  require_cmd docker
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 or newer is required"
  docker info >/dev/null 2>&1 || fail "Docker daemon is unreachable"
  [[ -r "$ENV_PATH" ]] || fail "env file missing or unreadable: $ENV_PATH; run bin/orchestrator setup"
  if [[ "$command" != stop ]]; then require_cmd python3; fi
  [[ "$command" == status ]] || lock_instance
  instance_adopt_caddy || fail "could not discover existing Caddy containers"
  case "$command" in
    start)
      [[ -n "$(instance_env_get AUTH_ENCRYPTION_KEY || true)$(instance_env_get AUTH_ENCRYPTION_KEYS || true)" && -n "$(instance_env_get DATA_ROOT || true)" ]] ||
        fail "setup is incomplete; run bin/orchestrator setup"
      instance_compose up -d --no-build --wait --wait-timeout 180 || {
        local start_rc=$?
        log 'Start failed; resume setup for missing images/schema, or inspect Docker service logs'
        return "$start_rc"
      }
      cmd_status
      ;;
    stop) instance_compose --profile '*' stop; log 'Instance stopped; containers and data retained' ;;
    status) cmd_status ;;
    update) cmd_update ;;
  esac
}

umask 077
on_exit() {
  local rc=$?
  if (( rc != 0 )); then
    log "Command failed (exit $rc), stage: ${STAGE:-startup}; revisions: ${PREVIOUS_REV:-unknown} -> ${TARGET_REV:-unknown}; backup: ${BACKUP_DIR:-none}"
    if [[ "${ORCHESTRATOR_USAGE_FAILED:-0}" == 1 ]]; then exit 2; else exit 1; fi
  fi
}
trap on_exit EXIT
main "$@"
