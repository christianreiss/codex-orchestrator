  version_rows=()
  codex_ver_inst="$(extract_version_token "$codex_installed_display")"
  codex_ver_target="$(extract_version_token "$codex_target_display")"
  codex_ver_line="${codex_ver_inst:-${codex_installed_display:-unknown}}"
