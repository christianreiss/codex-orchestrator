print_motd() {
  while IFS= read -r line; do
    printf "%b %s%b\n" "${ORANGE}${BOLD}" "$line" "${RESET}"
  done <<<"$MOTD_TEXT"
}

mask_key() {
  local key="$1"
  if [[ -z "$key" ]]; then
    printf 'none'
    return
  fi
  local len=${#key}
  if (( len <= 8 )); then
    printf '%s' "$key"
  else
    printf '%s…%s' "${key:0:4}" "${key: -4}"
  fi
}

emit_insecure_notice() {
  (( HOST_SECURITY_NOTICE_EMITTED )) && return
  log_warn "Host marked insecure; auth.json will be removed after this run."
  HOST_SECURITY_NOTICE_EMITTED=1
}

normalize_hostname() {
  local host="${1-}"
  # Drop newlines and trailing dots, and compare case-insensitively.
  host="${host//$'\r'/}"
  host="${host//$'\n'/}"
  host="${host%\.}"
  printf '%s' "$(lowercase "$host")"
}

enforce_baked_fqdn_guard() {
  local raw_fqdn="${CODEX_SYNC_FQDN:-}"
  if [[ -z "$raw_fqdn" || "$raw_fqdn" == __CODEX_SYNC_FQDN__ ]]; then
    return 0
  fi

  local baked
  baked="$(normalize_hostname "$raw_fqdn")"
  if [[ -z "$baked" ]]; then
    return 0
  fi

  local current
  current="$(normalize_hostname "$LOCAL_HOSTNAME")"
  if [[ -z "$current" || "$current" == "unknown" ]]; then
    current="$(normalize_hostname "$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo unknown)")"
  fi

  if [[ -z "$current" || "$current" == "unknown" ]]; then
    if (( CODEX_ALLOW_FQDN_MISMATCH )); then
      log_warn "Host FQDN unknown; baked for ${baked}. Proceeding because CODEX_ALLOW_FQDN_MISMATCH=1."
      return 0
    fi
    log_error "Baked for host ${baked}, but the current host FQDN is unknown."
    exit 1
  fi

  if [[ "$current" != "$baked" ]]; then
    if (( CODEX_ALLOW_FQDN_MISMATCH )); then
      log_warn "Host mismatch: baked for ${baked}, running on ${current}; proceeding because CODEX_ALLOW_FQDN_MISMATCH=1."
      return 0
    fi
    log_error "Host mismatch: baked for ${baked}, running on ${current}. Set CODEX_ALLOW_FQDN_MISMATCH=1 to override."
    exit 1
  fi
}

