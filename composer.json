{
    "name": "codex/auth-central",
    "description": "Centralized API for distributing codex auth.json",
    "type": "project",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6",
        "spomky-labs/cbor-php": "^3.0",
        "paragonie/constant_time_encoding": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "icanhazstring/composer-unused": "^0.9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test:phpunit": "vendor/bin/phpunit -c phpunit.xml.dist",
        "test": "@test:phpunit",
        "test:contracts": [
            "php scripts/verify-interface-contracts.php",
            "vendor/bin/phpunit -c phpunit.xml.dist tests/ContractSchemasTest.php tests/AuthServiceContractResponsesTest.php tests/AuthReasonContractsTest.php"
        ],
        "test:wrapper": [
            "vendor/bin/phpunit -c phpunit.xml.dist tests/WrapperV2*.php"
        ],
        "test:wrapper-go": "cd wrappers/cdx && go test ./... && cd ../clx && go test ./...",
        "lint:phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
        "lint:shell": "bash scripts/lint-shell.sh",
        "verify:wrapper": [
            "cd wrappers/cdx && go vet ./... && go test ./...",
            "cd ../clx && go vet ./... && go test ./..."
        ],
        "audit:composer-unused": "vendor/bin/composer-unused --no-progress --excludeDir=.github --excludeDir=docs --excludeDir=storage --excludeDir=vendor --excludePackage=vlucas/phpdotenv"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    }
}
